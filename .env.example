# Application
PORT=

# Database (PostgreSQL)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Redis
REDIS_HOST=
REDIS_PORT=

# Session
SESSION_SECRET=

# File storage: 's3' or 'local' (see FILES.md)
STORAGE_DRIVER=

# AWS S3 + CloudFront
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
CLOUDFRONT_DOMAIN=

# Mail (SMTP). For local dev use the mailpit service from docker-compose:
# MAIL_HOST=mailpit, MAIL_PORT=1025, MAIL_USER= (empty), MAIL_FROM=no-reply@sn-test.local
# and read the emails at http://localhost:8026. Empty MAIL_HOST: emails go to the app log.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Client
CLIENT_URL=

# Reverse proxy: 'true' only behind exactly one trusted proxy (nginx/ALB)
TRUST_PROXY=
