{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "<rootDir>/esm-to-cjs.transformer.js",
      { "tsconfig": "<rootDir>/tsconfig.e2e.json" }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/(config|typeorm|passport)|uuid|file-type|strtok3|token-types|@tokenizer/inflate|uint8array-extras|@borewit/text-codec)/)"
  ],
  "setupFiles": ["<rootDir>/e2e-env.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "maxWorkers": 1
}
